<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <TextView
        android:id="@+id/text_discover"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        android:text="Descobrir"
        android:textColor="#000000"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/text_rated_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0 filmes avaliados"
        android:textColor="#888888"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="@+id/text_discover"
        app:layout_constraintTop_toBottomOf="@+id/text_discover" />

    <com.yuyakaido.android.cardstackview.CardStackView
        android:id="@+id/card_stack_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toTopOf="@+id/layout_buttons"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/text_rated_count" />

    <LinearLayout
        android:id="@+id/layout_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@+id/text_swipe_hint">

        <ImageButton
            android:id="@+id/button_dislike"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_marginEnd="24dp"
            android:background="@drawable/outline_dislike"
            android:padding="20dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_dislike"
            app:tint="#D32F2F" />

        <ImageButton
            android:id="@+id/button_favorite"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="@drawable/outline_favorito"
            android:padding="22dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_star"
            app:tint="#FFA000" />

        <ImageButton
            android:id="@+id/button_like"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_marginStart="24dp"
            android:background="@drawable/outline_like"
            android:padding="20dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_like"
            app:tint="#388E3C" />

    </LinearLayout>

    <TextView
        android:id="@+id/text_swipe_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="← Deslize para avaliar →"
        android:textColor="#AAAAAA"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>